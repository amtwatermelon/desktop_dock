{
  "productName": "007 Desk",
  "version": "0.1.0",
  "identifier": "com.watermelon.tauri.tabs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "007 Desk",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}

